{
  "name": "voxon-functions",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud Functions de VOXON: cuentas, instancias, topes del plan, resúmenes y cobro",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').copyFileSync('../../shared/plans.json','src/plans.json')\"",
    "build": "tsc",
    "watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
