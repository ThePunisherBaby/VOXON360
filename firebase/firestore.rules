rules_version = '2';

// VOXON · Reglas multi-tenant.
//
//   accounts/{cuenta}             quien paga: plan, topes, uso y facturación (solo las Functions)
//   instances/{instancia}         un negocio o sucursal con su modo
//   instances/.../members/{uid}   personas (kind "user") y cajas (kind "device") con su rol
//   instances/.../staff           empleados con PIN; el hash vive en staffSecrets, que nadie lee
//   instances/.../devices         cajas con VOXON POS
//
// Principio: nadie ve ni escribe fuera de su instancia. El dinero, las cajas y los PIN los maneja
// el servidor (Cloud Functions con el SDK de administrador, que se salta estas reglas). Una caja
// sin empleado adentro tiene rol "locked": ve los datos pero no vende.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function accountMemberPath(accountId) {
      return /databases/$(database)/documents/accounts/$(accountId)/members/$(uid());
    }

    function instancePath(instanceId) {
      return /databases/$(database)/documents/instances/$(instanceId);
    }

    function instanceMemberPath(instanceId) {
      return /databases/$(database)/documents/instances/$(instanceId)/members/$(uid());
    }

    function isAccountMember(accountId, roles) {
      return signedIn()
        && exists(accountMemberPath(accountId))
        && get(accountMemberPath(accountId)).data.role in roles;
    }

    function instanceRole(instanceId) {
      return get(instanceMemberPath(instanceId)).data.role;
    }

    function inInstance(instanceId) {
      return signedIn() && exists(instanceMemberPath(instanceId));
    }

    function hasRole(instanceId, roles) {
      return inInstance(instanceId) && instanceRole(instanceId) in roles;
    }

    // Dueño de la instancia (persona) o dueño/administrador de su cuenta.
    function isInstanceAdmin(instanceId) {
      return (hasRole(instanceId, ['owner'])
          && get(instanceMemberPath(instanceId)).data.get('kind', 'user') != 'device')
        || isAccountMember(get(instancePath(instanceId)).data.accountId, ['owner', 'admin']);
    }

    // Lo que ve cualquier miembro de la instancia, cajas incluidas.
    function readable() {
      return ['products', 'categories', 'customers', 'tables', 'areas', 'stations', 'settings',
              'staff', 'devices', 'sales', 'cashSessions', 'orders', 'days'];
    }

    // Lo que administran el dueño y el gerente directamente.
    function managed() {
      return ['products', 'categories', 'customers', 'tables', 'areas', 'stations', 'settings'];
    }

    // Campos de la cuenta que solo escribe el servidor.
    function serverOnly() {
      return ['plan', 'limits', 'usage', 'billing'];
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function invitePath(code) {
      return /databases/$(database)/documents/invites/$(code);
    }

    // Invitación vigente para esa instancia y ese rol.
    function validInvite(instanceId, code, role) {
      let invite = invitePath(code);
      return code is string
        && exists(invite)
        && get(invite).data.instanceId == instanceId
        && get(invite).data.role == role
        && get(invite).data.expiresAt > request.time;
    }

    // --- Cuentas -------------------------------------------------------------

    match /accounts/{accountId} {
      allow get: if isAccountMember(accountId, ['owner', 'admin']);
      allow list: if false;
      // La crea la Function createAccount, que fija el plan de prueba.
      allow create: if false;
      allow update: if isAccountMember(accountId, ['owner', 'admin'])
        && !changedKeys().hasAny(serverOnly())
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;

      match /members/{memberUid} {
        allow read: if isAccountMember(accountId, ['owner', 'admin']) || (signedIn() && memberUid == uid());
        // El dueño agrega administradores; el primer dueño lo crea createAccount.
        allow create: if isAccountMember(accountId, ['owner']);
        allow update, delete: if isAccountMember(accountId, ['owner']) && memberUid != uid();
      }
      // accounts/{cuenta}/people es un conteo interno del servidor: sin acceso para las apps.
    }

    // --- Instancias ----------------------------------------------------------

    match /instances/{instanceId} {
      allow get: if inInstance(instanceId)
        || isAccountMember(resource.data.accountId, ['owner', 'admin']);
      // Las apps buscan las instancias donde trabaja el usuario.
      allow list: if signedIn();
      // La crea la Function createInstance, que revisa el tope de negocios del plan.
      allow create: if false;
      allow update: if (hasRole(instanceId, ['owner', 'manager'])
          || isAccountMember(resource.data.accountId, ['owner', 'admin']))
        && !changedKeys().hasAny(['accountId', 'mode', 'deviceCount']);
      allow delete: if false;

      match /members/{memberUid} {
        allow read: if inInstance(instanceId);
        // Solo el dueño decide quién trabaja aquí; o se entra con una invitación vigente.
        // Las cajas y la sesión de su empleado las manejan las Functions.
        allow create: if isInstanceAdmin(instanceId)
          || (signedIn() && memberUid == uid()
              && validInvite(instanceId, request.resource.data.inviteCode, request.resource.data.role));
        allow update, delete: if isInstanceAdmin(instanceId) && memberUid != uid();
      }

      match /{collection}/{documentId} {
        allow read: if inInstance(instanceId) && collection in readable();
        allow write: if collection in managed() && hasRole(instanceId, ['owner', 'manager']);
      }

      // Empleados y cajas: por Functions (PIN con hash, topes del plan). staffSecrets no se lee nunca.
      match /staff/{staffId} {
        allow write: if false;
      }

      match /devices/{deviceUid} {
        allow write: if false;
      }

      // Una venta cobrada no se cambia: solo se anula, y eso lo hace el dueño o un gerente.
      match /sales/{saleId} {
        allow create: if hasRole(instanceId, ['owner', 'manager', 'cashier']);
        allow update: if hasRole(instanceId, ['owner', 'manager'])
          && resource.data.status == 'completed'
          && request.resource.data.status == 'voided'
          && changedKeys().hasOnly(['status', 'voidedAt', 'voidedBy', 'voidReason']);
        allow delete: if false;
      }

      // La caja cerrada tampoco cambia.
      match /cashSessions/{sessionId} {
        allow create: if hasRole(instanceId, ['owner', 'manager', 'cashier']);
        allow update: if hasRole(instanceId, ['owner', 'manager', 'cashier'])
          && resource.data.closedAt == null;
        allow delete: if false;
      }

      // Restaurante: el personal de salón toma la orden, cocina solo mueve su estado.
      match /orders/{orderId} {
        allow create, update: if hasRole(instanceId, ['owner', 'manager', 'cashier', 'waiter'])
          || (hasRole(instanceId, ['kitchen'])
              && changedKeys().hasOnly(['items', 'updatedAt']));
        allow delete: if false;
      }

      // Resúmenes del día: los arma el servidor.
      match /days/{day} {
        allow write: if false;
      }
    }

    // --- Códigos ---------------------------------------------------------------

    // Vinculación por QR: la caja y quien escaneó siguen el estado en vivo. El token del QR y
    // los códigos viven con hash en secrets, sin acceso para ninguna app.
    match /pairings/{pairingId} {
      allow get: if signedIn()
        && (resource.data.deviceUid == uid() || resource.data.claimedBy == uid());
      allow list, create, update, delete: if false;

      match /secrets/{secret} {
        allow read, write: if false;
      }
    }

    // Códigos de caja: solo los crean y canjean las Functions.
    match /deviceCodes/{code} {
      allow read, write: if false;
    }

    // Invitaciones: las crea la Function createInvite; la persona invitada las lee para entrar.
    match /invites/{code} {
      allow get: if signedIn() && resource.data.expiresAt > request.time;
      allow list, create, update: if false;
      allow delete: if hasRole(resource.data.instanceId, ['owner', 'manager']);
    }
  }
}
