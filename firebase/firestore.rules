rules_version = '2';

// VOXON · Reglas multi-tenant.
//
//   accounts/{cuenta}        quien paga: plan, topes y facturación (solo las Functions los tocan)
//   instances/{instancia}    un negocio o sucursal, con su modo (colmado, restaurante, supermercado, tienda)
//   instances/.../members    empleados de esa instancia y su rol
//
// Principio: nadie ve ni escribe fuera de su instancia. El dinero (plan, límites, uso, facturación)
// solo lo escribe el servidor (Cloud Functions con el SDK de administrador, que se salta estas reglas).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function accountMemberPath(accountId) {
      return /databases/$(database)/documents/accounts/$(accountId)/members/$(uid());
    }

    function instancePath(instanceId) {
      return /databases/$(database)/documents/instances/$(instanceId);
    }

    function instanceMemberPath(instanceId) {
      return /databases/$(database)/documents/instances/$(instanceId)/members/$(uid());
    }

    function isAccountMember(accountId, roles) {
      return signedIn()
        && exists(accountMemberPath(accountId))
        && get(accountMemberPath(accountId)).data.role in roles;
    }

    function instanceRole(instanceId) {
      return get(instanceMemberPath(instanceId)).data.role;
    }

    function inInstance(instanceId) {
      return signedIn() && exists(instanceMemberPath(instanceId));
    }

    function hasRole(instanceId, roles) {
      return inInstance(instanceId) && instanceRole(instanceId) in roles;
    }

    // Campos que solo escribe el servidor.
    function serverOnly() {
      return ['plan', 'limits', 'usage', 'billing'];
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function invitePath(code) {
      return /databases/$(database)/documents/invites/$(code);
    }

    // Invitación vigente para esa instancia y ese rol.
    function validInvite(instanceId, code, role) {
      let invite = invitePath(code);
      return code is string
        && exists(invite)
        && get(invite).data.instanceId == instanceId
        && get(invite).data.role == role
        && get(invite).data.expiresAt > request.time;
    }

    // --- Cuentas -------------------------------------------------------------

    match /accounts/{accountId} {
      allow get: if isAccountMember(accountId, ['owner', 'admin']);
      allow list: if false;

      // La cuenta la crea la Function createAccount, que fija el plan de prueba.
      allow create: if false;

      allow update: if isAccountMember(accountId, ['owner', 'admin'])
        && !changedKeys().hasAny(serverOnly())
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;

      match /members/{memberUid} {
        allow read: if isAccountMember(accountId, ['owner', 'admin']) || (signedIn() && memberUid == uid());
        // El dueño agrega administradores; el primer dueño lo crea createAccount.
        allow create: if isAccountMember(accountId, ['owner']);
        allow update, delete: if isAccountMember(accountId, ['owner']) && memberUid != uid();
      }
    }

    // --- Instancias ----------------------------------------------------------

    match /instances/{instanceId} {
      allow get: if inInstance(instanceId)
        || isAccountMember(resource.data.accountId, ['owner', 'admin']);
      // La app busca las instancias donde trabaja el usuario.
      allow list: if signedIn();

      // Las crea la Function createInstance, que revisa el tope de negocios del plan.
      allow create: if false;

      allow update: if (hasRole(instanceId, ['owner', 'manager'])
          || isAccountMember(resource.data.accountId, ['owner', 'admin']))
        && request.resource.data.accountId == resource.data.accountId
        && request.resource.data.mode == resource.data.mode;
      allow delete: if false;

      match /members/{memberUid} {
        allow read: if inInstance(instanceId);
        // Se entra con una invitación vigente, o el dueño agrega a mano.
        allow create: if hasRole(instanceId, ['owner', 'manager'])
          || isAccountMember(get(instancePath(instanceId)).data.accountId, ['owner', 'admin'])
          || (signedIn() && memberUid == uid()
              && validInvite(instanceId, request.resource.data.inviteCode, request.resource.data.role));
        allow update, delete: if hasRole(instanceId, ['owner', 'manager'])
          || isAccountMember(get(instancePath(instanceId)).data.accountId, ['owner', 'admin']);
      }

      // Catálogo, clientes, mesas y ajustes: los administra quien manda en la instancia.
      match /{collection}/{documentId} {
        allow read: if inInstance(instanceId)
          && collection in ['products', 'customers', 'tables', 'settings', 'sales', 'cashSessions', 'orders', 'days'];
        allow write: if collection in ['products', 'customers', 'tables', 'settings']
          && hasRole(instanceId, ['owner', 'manager']);
      }

      // Una venta cobrada no se cambia: solo se anula, y eso lo hace el dueño o un gerente.
      match /sales/{saleId} {
        allow create: if hasRole(instanceId, ['owner', 'manager', 'cashier']);
        allow update: if hasRole(instanceId, ['owner', 'manager'])
          && resource.data.status == 'completed'
          && request.resource.data.status == 'voided'
          && changedKeys().hasOnly(['status', 'voidedAt', 'voidedBy', 'voidReason']);
        allow delete: if false;
      }

      // La caja cerrada tampoco cambia.
      match /cashSessions/{sessionId} {
        allow create: if hasRole(instanceId, ['owner', 'manager', 'cashier']);
        allow update: if hasRole(instanceId, ['owner', 'manager', 'cashier'])
          && resource.data.closedAt == null;
        allow delete: if false;
      }

      // Restaurante: el personal de salón toma la orden, cocina solo mueve su estado.
      match /orders/{orderId} {
        allow create, update: if hasRole(instanceId, ['owner', 'manager', 'cashier', 'waiter'])
          || (hasRole(instanceId, ['kitchen'])
              && changedKeys().hasOnly(['items', 'updatedAt']));
        allow delete: if false;
      }

      // Resúmenes del día: los arma el servidor.
      match /days/{day} {
        allow write: if false;
      }
    }

    // --- Invitaciones --------------------------------------------------------

    match /invites/{code} {
      allow get: if signedIn() && resource.data.expiresAt > request.time;
      allow list: if false;
      allow create: if hasRole(request.resource.data.instanceId, ['owner', 'manager'])
        && request.resource.data.role in ['owner', 'manager', 'cashier', 'waiter', 'kitchen']
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(7, 'd');
      allow update: if false;
      allow delete: if hasRole(resource.data.instanceId, ['owner', 'manager']);
    }
  }
}
