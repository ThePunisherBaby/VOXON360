rules_version = '2';

// VOXON90 · Datos que la caja principal sube para la app del dueño.
//
// - El dueño entra a su app con Firebase Auth, crea su negocio y genera códigos de vínculo.
// - La caja principal entra como usuario anónimo, se registra como equipo del negocio con un
//   código vigente y desde entonces solo escribe los resúmenes (days y snapshots) de ese negocio.
// - Solo los dueños leen los datos. Vender nunca depende de Firebase: todo pasa primero en la caja.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function businessPath(businessId) {
      return /databases/$(database)/documents/businesses/$(businessId);
    }

    function isOwner(businessId) {
      return signedIn()
        && exists(businessPath(businessId))
        && request.auth.uid in get(businessPath(businessId)).data.ownerUids;
    }

    function isDevice(businessId) {
      return signedIn()
        && exists(/databases/$(database)/documents/businesses/$(businessId)/devices/$(request.auth.uid));
    }

    function validLinkCode(businessId, code) {
      let linkPath = /databases/$(database)/documents/linkCodes/$(code);
      return code is string
        && exists(linkPath)
        && get(linkPath).data.businessId == businessId
        && get(linkPath).data.expiresAt > request.time;
    }

    match /businesses/{businessId} {
      allow read: if signedIn() && request.auth.uid in resource.data.ownerUids;
      allow create: if signedIn()
        && request.resource.data.ownerUids == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80;
      allow update: if signedIn()
        && request.auth.uid in resource.data.ownerUids
        && request.resource.data.ownerUids == resource.data.ownerUids;
      allow delete: if false;

      // Cajas principales vinculadas. El dueño puede quitar una para revocarla.
      match /devices/{deviceUid} {
        allow read: if isOwner(businessId) || (signedIn() && request.auth.uid == deviceUid);
        allow create: if signedIn()
          && request.auth.uid == deviceUid
          && validLinkCode(businessId, request.resource.data.linkCode);
        allow update: if false;
        allow delete: if isOwner(businessId) || (signedIn() && request.auth.uid == deviceUid);
      }

      match /days/{day} {
        allow read: if isOwner(businessId);
        allow write: if isDevice(businessId) && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }

      match /snapshots/{name} {
        allow read: if isOwner(businessId);
        allow write: if isDevice(businessId) && name in ['status', 'cash', 'inventory', 'receivables'];
      }
    }

    // Código de un solo uso que el dueño dicta en la caja principal. Vence en 30 minutos o menos.
    match /linkCodes/{code} {
      allow get: if signedIn() && resource.data.expiresAt > request.time;
      allow list: if false;
      allow create: if code.matches('^[A-HJ-NP-Z2-9]{8}$')
        && isOwner(request.resource.data.businessId)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(30, 'm');
      allow update: if false;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
